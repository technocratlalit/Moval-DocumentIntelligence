# Copy to .env on server: cp env.docker.example .env
# Fill real values. Same file powers all 4 docker-compose services.
#
# PUBLIC_URL = URL testers open in browser (set to https://your-domain before VPS deploy)
PUBLIC_URL=http://localhost
WEB_PORT=80

JWT_SECRET=
WEBHOOK_SECRET=
# Dev fallback (test-backend) — used when X-Aimodule-Tenant header is absent
WEBHOOK_URL=http://test-backend:3001/api/webhook/extraction-complete
# Production Laravel tenants (required when Laravel sends X-Aimodule-Tenant)
WEBHOOK_URL_IN=https://moval.techkrate.in/backend/api/ai-module/webhook/extraction-complete
WEBHOOK_URL_COM=https://moval.techkrate.com/backend/api/ai-module/webhook/extraction-complete
SESSION_SECRET=
ADMIN_API_KEY=
PORTAL_PASSWORD=
DATABASE_URI=

R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

GEMINI_API_KEY=
LLAMA_CLOUD_API_KEY=
REDIS_QUEUE_URI=redis://valkey:6379
REDIS_RATE_LIMIT_URI=redis://valkey:6379

GCS_BUCKET_NAME=
GCS_PROJECT_ID=
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY=

RUN_WORKERS=false
RUN_DLQ_WORKER=true
DEFAULT_EXTRACT_MODE=async

# New Relic — logs/traces from API, worker, and portal
OBSERVABILITY_PROVIDER=newrelic
NEW_RELIC_ENABLED=true
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=docs-intelligence-api
NEW_RELIC_WORKER_APP_NAME=docs-intelligence-worker
NEW_RELIC_PORTAL_APP_NAME=docs-intelligence-portal
NEW_RELIC_LOG_FILEPATH=stdout
NEW_RELIC_APPLICATION_LOGGING_ENABLED=true
NEW_RELIC_APPLICATION_LOGGING_FORWARDING_ENABLED=true

OTEL_ENABLED=false

# Extraction tuning
PRESCREEN_REJECT_CONFIDENCE=0.25
PRESCREEN_BLUR_CONFIDENCE=0.55
PRESCREEN_LARGE_PDF_PAGE1=true
