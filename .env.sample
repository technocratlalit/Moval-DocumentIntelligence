

PUBLIC_URL=http://localhost
WEB_PORT=80

# aimodule API — host port published for Laravel on another server (default 3000)
AIMODULE_PORT=3000

#Shared secrets (MUST match between aimodule + Laravel / test-backend)
JWT_SECRET=changeme-jwt-secret
WEBHOOK_SECRET=changeme-webhook-secret
# Dev fallback (test-backend in compose) — used when X-Aimodule-Tenant header is absent
WEBHOOK_URL=http://test-backend:3001/api/webhook/extraction-complete
# Production: Laravel .in / .com send X-Aimodule-Tenant header; aimodule routes to matching URL
WEBHOOK_URL_IN=https://moval.techkrate.in/backend/api/ai-module/webhook/extraction-complete
WEBHOOK_URL_COM=https://moval.techkrate.com/backend/api/ai-module/webhook/extraction-complete
SESSION_SECRET=changeme-session-secret
ADMIN_API_KEY=changeme-admin-key

# Tester portal (test-backend)
PORTAL_PASSWORD=changeme-portal-password
DATABASE_URI=mongodb+srv://user:password@cluster.mongodb.net/docs

# test-backend: R2 storage 
R2_ACCOUNT_ID=changeme
R2_ACCESS_KEY=changeme
R2_SECRET_KEY=changeme
R2_BUCKET=changeme-bucket
R2_PUBLIC_URL=https://your-r2-public-url.example.com

# aimodule: Gemini (3 tiers — per-doc types inherit from LITE/PRO)
GEMINI_API_KEY=changeme
GEMINI_API_KEY_LABEL=production

# aimodule: LlamaCloud Extract (LlamaParse workshop experiment)
LLAMA_CLOUD_API_KEY=changeme
AI_MODEL=gemini-3.1-flash-lite
AI_MODEL_LITE=gemini-3.1-flash-lite
AI_MODEL_PRO=gemini-3.1-flash-lite

# aimodule: Claim form extraction (single Gemini pass)
CLAIM_AI_MODEL=gemini-2.5-flash-lite
CLAIM_MAX_OUTPUT_TOKENS=8192
CLAIM_MAX_GEMINI_RETRIES=1
CLAIM_MAX_PDF_PAGES=5

# aimodule: Workshop bills via LlamaCloud Extract (see LLAMA_CLOUD_API_KEY above)
# Optional per-doc model overrides (blank → RC/DL/prescreen use AI_MODEL_LITE,
# policy uses AI_MODEL_PRO)
RC_AI_MODEL=
DL_AI_MODEL=
POLICY_AI_MODEL=
PRESCREEN_MODEL=

# Pricing per tier (USD per 1M tokens) — update when you change models above
AI_MODEL_INPUT_USD_PER_1M=0.25
AI_MODEL_OUTPUT_USD_PER_1M=1.50
AI_MODEL_LITE_INPUT_USD_PER_1M=0.25
AI_MODEL_LITE_OUTPUT_USD_PER_1M=1.50
AI_MODEL_PRO_INPUT_USD_PER_1M=0.30
AI_MODEL_PRO_OUTPUT_USD_PER_1M=2.50
AI_MODEL_CACHE_INPUT_USD_PER_1M=0.025
AI_MODEL_LITE_CACHE_INPUT_USD_PER_1M=0.025
AI_MODEL_PRO_CACHE_INPUT_USD_PER_1M=0.03
USD_TO_INR=94.3

PROMPT_CACHING=implicit
PROMPT_CACHE_TTL_SECONDS=3600

# Token ceilings & extraction (aimodule)
RC_MAX_OUTPUT_TOKENS=3072
DL_MAX_OUTPUT_TOKENS=3072
POLICY_MAX_OUTPUT_TOKENS=65536
POLICY_MAX_GEMINI_RETRIES=1
RC_MAX_GEMINI_RETRIES=1
DL_MAX_GEMINI_RETRIES=1
PRESCREEN_ENABLED=true
PRESCREEN_MAX_PDF_PAGES=3
PRESCREEN_MAX_OUTPUT_TOKENS=512
PRESCREEN_REJECT_CONFIDENCE=0.25
PRESCREEN_BLUR_CONFIDENCE=0.55
PRESCREEN_LARGE_PDF_PAGE1=true

# aimodule: Valkey / Queue (compose service — internal only, not exposed to host)
REDIS_QUEUE_URI=redis://valkey:6379
REDIS_RATE_LIMIT_URI=redis://valkey:6379
QUEUE_PREFIX=bull
MAX_QUEUE_SIZE=50
JOB_TIMEOUT_MS=660000
GEMINI_CIRCUIT_TIMEOUT_MS=600000
WORKER_LOCK_DURATION_MS=630000
DOWNLOAD_TIMEOUT_MS=45000
PDF_DOWNLOAD_TIMEOUT_MS=120000
QUEUE_PRIORITY_FAST=1
QUEUE_PRIORITY_HEAVY=5
QUEUE_PRIORITY_URGENT=1
QUEUE_PRIORITY_LOW=10
DEFAULT_EXTRACT_MODE=async

RESULT_CACHE_ENABLED=true
RESULT_CACHE_TTL_SECONDS=86400
RUN_WORKERS=false
RUN_DLQ_WORKER=true
DLQ_ALERT_THRESHOLD=20

# aimodule: GCS
GCS_BUCKET_NAME=changeme-bucket
GCS_PROJECT_ID=changeme-project
GCS_CLIENT_EMAIL=service-account@changeme-project.iam.gserviceaccount.com
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nchangeme\n-----END PRIVATE KEY-----\n"

# Observability — New Relic (API + worker + portal)
OBSERVABILITY_PROVIDER=newrelic
NEW_RELIC_ENABLED=true
NEW_RELIC_LICENSE_KEY=changeme-nr-license-key
NEW_RELIC_APP_NAME=docs-intelligence-api
NEW_RELIC_WORKER_APP_NAME=docs-intelligence-worker
NEW_RELIC_PORTAL_APP_NAME=docs-intelligence-portal
NEW_RELIC_LOG_FILEPATH=stdout
NEW_RELIC_LOG_LEVEL=info
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true
NEW_RELIC_AI_MONITORING_ENABLED=true
NEW_RELIC_APPLICATION_LOGGING_ENABLED=true
NEW_RELIC_APPLICATION_LOGGING_FORWARDING_ENABLED=true
NEW_RELIC_APPLICATION_LOGGING_LOCAL_DECORATING_ENABLED=true
NEW_RELIC_ERROR_COLLECTOR_IGNORE_ERROR_CODES=400,401,403,404,422


OTEL_ENABLED=false
